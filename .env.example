# Copy to .env and fill in your key. NEVER commit .env.
#
# DEFAULT PROVIDER: Google AI Studio (easiest — free API key, no billing/credit setup).
#   1. Go to https://aistudio.google.com/apikey
#   2. Click "Create API key" (sign in with a Google account). Copy it.
#   3. Paste it below as INFERENCE_API_KEY. Done.

# OpenAI-compatible Gemini endpoint that also serves the open-weight Gemma models.
INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemma 4, open-weight. Run `python scripts/smoke_inference.py` to list the exact
# Gemma ids your key can access and confirm this one (variants: 12b, 31b, etc.).
GEMMA_MODEL_ID=gemma-4-12b-it

# Guaranteed-available open-weight fallback if the Gemma 4 id above isn't enabled yet.
FALLBACK_MODEL_ID=gemma-3-27b-it

# Your Google AI Studio API key. Keep it secret.
INFERENCE_API_KEY=replace-me

# --- Alternative provider: DigitalOcean Gradient AI (optional) ----------------
# To serve Gemma on DigitalOcean instead, comment the two lines above, uncomment
# these, and put your DO model-access key in INFERENCE_API_KEY:
#   INFERENCE_BASE_URL=https://inference.do-ai.run/v1
#   GEMMA_MODEL_ID=gemma-4-31B-it
